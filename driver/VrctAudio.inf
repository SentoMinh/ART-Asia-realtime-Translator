; Development package: must pass InfVerif, HLK and Microsoft signing before shipping.
[Version]
Signature="$Windows NT$"
Class=MEDIA
ClassGUID={4d36e96c-e325-11ce-bfc1-08002be10318}
Provider=%Provider%
DriverVer=10/12/2026,0.1.0.0
CatalogFile=VrctAudio.cat
PnpLockDown=1

[Manufacturer]
%Provider%=Models,NTamd64.10.0...19045
[Models.NTamd64.10.0...19045]
%Device%=Audio,Root\VRCT_Audio

[SourceDisksNames]
1=%Device%,,,
[SourceDisksFiles]
VrctAudio.sys=1
[DestinationDirs]
DriverCopy=13
[DriverCopy]
VrctAudio.sys

[Audio.NT]
Include=ks.inf,wdmaudio.inf
Needs=KS.Registration,WDMAUDIO.Registration
CopyFiles=DriverCopy
AddReg=Audio.AddReg
[Audio.AddReg]
HKR,,AssociatedFilters,,"wdmaud"
HKR,,Driver,,VrctAudio.sys
HKR,Drivers,SubClasses,,"wave,mixer"
HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\wave\wdmaud.drv,Description,,%Device%
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Description,,%Device%

[Audio.NT.Interfaces]
AddInterface=%AudioCategory%,WaveHdmi,RenderWave
AddInterface=%RenderCategory%,WaveHdmi,RenderWave
AddInterface=%RealtimeCategory%,WaveHdmi,RenderWave
AddInterface=%AudioCategory%,TopologyHdmi,RenderTopology
AddInterface=%TopologyCategory%,TopologyHdmi,RenderTopology
AddInterface=%AudioCategory%,WaveVrctMusic,MusicWave
AddInterface=%RenderCategory%,WaveVrctMusic,MusicWave
AddInterface=%RealtimeCategory%,WaveVrctMusic,MusicWave
AddInterface=%AudioCategory%,TopologyVrctMusic,MusicTopology
AddInterface=%TopologyCategory%,TopologyVrctMusic,MusicTopology
AddInterface=%AudioCategory%,WaveMicIn,CaptureWave
AddInterface=%CaptureCategory%,WaveMicIn,CaptureWave
AddInterface=%RealtimeCategory%,WaveMicIn,CaptureWave
AddInterface=%AudioCategory%,TopologyMicIn,CaptureTopology
AddInterface=%TopologyCategory%,TopologyMicIn,CaptureTopology

[RenderWave]
AddReg=RenderWave.Reg
[RenderWave.Reg]
HKR,,CLSID,,%Proxy%
HKR,,FriendlyName,,%Mix%
[RenderTopology]
AddReg=RenderTopology.Reg
[RenderTopology.Reg]
HKR,,CLSID,,%Proxy%
HKR,,FriendlyName,,%Mix%
HKR,EP\0,%Association%,,%AnyNode%
HKR,EP\0,%EventDriven%,0x00010001,1

[MusicWave]
AddReg=MusicWave.Reg
[MusicWave.Reg]
HKR,,CLSID,,%Proxy%
HKR,,FriendlyName,,%Music%
[MusicTopology]
AddReg=MusicTopology.Reg
[MusicTopology.Reg]
HKR,,CLSID,,%Proxy%
HKR,,FriendlyName,,%Music%
HKR,EP\0,%Association%,,%AnyNode%
HKR,EP\0,%EventDriven%,0x00010001,1

[CaptureWave]
AddReg=CaptureWave.Reg
[CaptureWave.Reg]
HKR,,CLSID,,%Proxy%
HKR,,FriendlyName,,%Microphone%
[CaptureTopology]
AddReg=CaptureTopology.Reg
[CaptureTopology.Reg]
HKR,,CLSID,,%Proxy%
HKR,,FriendlyName,,%Microphone%
HKR,EP\0,%Association%,,%AnyNode%
HKR,EP\0,%EventDriven%,0x00010001,1

[Audio.NT.Services]
AddService=VrctAudio,0x00000002,Audio.Service
[Audio.Service]
DisplayName=%Device%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\VrctAudio.sys
[Audio.NT.HW]
AddReg=Audio.Security
[Audio.Security]
HKR,,DeviceType,0x10001,0x1d
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GRGWGX;;;BA)(A;;GRGWGX;;;WD)(A;;GRGWGX;;;RC)"
[Audio.NT.Wdf]
KmdfService=VrctAudio,Audio.Wdf
[Audio.Wdf]
KmdfLibraryVersion=1.15

